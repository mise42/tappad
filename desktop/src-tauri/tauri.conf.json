{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TapPad Desktop Host",
  "version": "0.1.0",
  "identifier": "net.tappad.desktop-host",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TapPad Desktop Host",
        "width": 920,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
